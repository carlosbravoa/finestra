# wdcomp — the web-desktop compositor. See ../docs/wayland.md.
#
# Needs libwayland-dev, libxkbcommon-dev and zlib1g-dev. Nothing else: the
# protocol marshalling is generated by wayland-scanner from the XML in
# protocols/, so none of it is hand-written.
#
# Those XML files are in the repository rather than read out of
# /usr/share/wayland-protocols because which of them a distribution has is a
# property of its release date, not of the protocol — 22.04 has one of the
# three. protocols/README.md has the table. wayland-scanner itself comes from
# libwayland-bin, which libwayland-dev already depends on.

PROTO_DIR := protocols
SCANNER   := $(shell pkg-config --variable=wayland_scanner wayland-scanner)

BUILD := build
BIN   := $(BUILD)/wdcomp

CFLAGS  ?= -O2 -g
# _GNU_SOURCE for memfd_create, which is how the xkb keymap reaches the client.
CFLAGS  += -std=c11 -D_GNU_SOURCE -Wall -Wextra -Wno-unused-parameter \
           -I$(BUILD) $(shell pkg-config --cflags wayland-server xkbcommon)
LDLIBS  := $(shell pkg-config --libs wayland-server xkbcommon xcb) -lz

# Generated protocol code. tablet-v2 is here only because cursor-shape-v1
# references zwp_tablet_tool_v2 in one request we do not implement — the
# symbol still has to exist at link time.
PROTOCOLS := \
  $(PROTO_DIR)/xdg-shell.xml \
  $(PROTO_DIR)/cursor-shape-v1.xml \
  $(PROTO_DIR)/tablet-v2.xml

GEN_H := $(BUILD)/xdg-shell-server-protocol.h \
         $(BUILD)/cursor-shape-v1-server-protocol.h \
         $(BUILD)/tablet-v2-server-protocol.h
GEN_C := $(BUILD)/xdg-shell-protocol.c \
         $(BUILD)/cursor-shape-v1-protocol.c \
         $(BUILD)/tablet-v2-protocol.c
GEN_O := $(GEN_C:.c=.o)
OBJS  := $(BUILD)/wdcomp.o $(BUILD)/png.o $(BUILD)/ipc.o $(BUILD)/xwm.o $(GEN_O)

.PHONY: all clean check check-ipc check-glibc
all: $(BIN)

$(BUILD):
	mkdir -p $(BUILD)

# One pair of rules for all three, now that the XML sits at a predictable path
# instead of under whichever of stable/, staging/ or unstable/ upstream happened
# to file each protocol in.
$(BUILD)/%-server-protocol.h: $(PROTO_DIR)/%.xml | $(BUILD)
	$(SCANNER) server-header $< $@
$(BUILD)/%-protocol.c: $(PROTO_DIR)/%.xml | $(BUILD)
	$(SCANNER) private-code $< $@

# Generated by a pattern rule and used only as an intermediate, which is enough
# for make to delete them again after every build. They are cheap to make but
# the churn is confusing.
.SECONDARY: $(GEN_C) $(GEN_H)

$(BUILD)/%.o: src/%.c $(GEN_H) | $(BUILD)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD)/%-protocol.o: $(BUILD)/%-protocol.c $(GEN_H)
	$(CC) $(CFLAGS) -c $< -o $@

$(BIN): $(OBJS)
	$(CC) $(OBJS) $(LDLIBS) -o $@

# ipc.c on its own: no Wayland, no application, no display — which is why it is
# the one piece `npm test` can check on any machine. It compiles ipc.c directly
# rather than reusing build/ipc.o, so that it does not drag in the generated
# protocol headers and with them a libwayland this host may not have.
IPC_TEST_CFLAGS := -O2 -g -std=c11 -D_GNU_SOURCE -Wall -Wextra -Wno-unused-parameter

$(BUILD)/ipc-test: src/ipc-test.c src/ipc.c src/ipc.h | $(BUILD)
	$(CC) $(IPC_TEST_CFLAGS) -Isrc src/ipc-test.c src/ipc.c -o $@

check-ipc: $(BUILD)/ipc-test
	@$(BUILD)/ipc-test

# A client with a subsurface, for the suite to launch through the service: the
# shape of Firefox without Firefox. Needs libwayland-client, which the build
# host has whenever it has libwayland-dev; nothing ships it.
$(BUILD)/xdg-shell-client-protocol.h: $(PROTO_DIR)/xdg-shell.xml | $(BUILD)
	$(SCANNER) client-header $< $@

$(BUILD)/subsurface-client: src/subsurface-client.c $(BUILD)/xdg-shell-client-protocol.h $(BUILD)/xdg-shell-protocol.o
	$(CC) $(CFLAGS) $(shell pkg-config --cflags wayland-client) $< $(BUILD)/xdg-shell-protocol.o \
		$(shell pkg-config --libs wayland-client) -o $@

subsurface-client: $(BUILD)/subsurface-client
.PHONY: subsurface-client

# Does this machine have what the build needs? wayland-protocols is no longer
# on the list: the XML it would have provided is in protocols/.
check:
	@pkg-config --exists wayland-server || { echo "missing: libwayland-dev"; exit 1; }
	@pkg-config --exists xkbcommon || { echo "missing: libxkbcommon-dev"; exit 1; }
	@test -n "$(SCANNER)" || { echo "missing: wayland-scanner (libwayland-bin)"; exit 1; }
	@for xml in $(PROTOCOLS); do \
		test -f "$$xml" || { echo "missing: $$xml"; exit 1; }; \
	done
	@echo "ok"

# The newest glibc symbol version the binary asks for, which is the oldest
# glibc it can start on. 2.34 is the floor the release is verified against
# (Rocky 9, Amazon Linux 2023). A newer header on the builder can raise it
# without a line of our code changing — glibc 2.38 renamed strtol and sscanf
# under _GNU_SOURCE, and the only symptom was a compositor that would not start
# on Debian 12 — so the release build runs this rather than trusting it.
GLIBC_FLOOR := 2.34

check-glibc: $(BIN)
	@need=$$(objdump -T $(BIN) | grep -o 'GLIBC_[0-9][0-9.]*' | sed 's/GLIBC_//' | sort -Vu | tail -n 1); \
	if [ "$$(printf '%s\n%s\n' "$$need" "$(GLIBC_FLOOR)" | sort -V | tail -n 1)" != "$(GLIBC_FLOOR)" ]; then \
		echo "wdcomp needs glibc $$need, past the $(GLIBC_FLOOR) floor:"; \
		objdump -T $(BIN) | grep "GLIBC_$$need" | awk '{ print "  ", $$NF }'; \
		exit 1; \
	fi; \
	echo "wdcomp needs glibc $$need (floor $(GLIBC_FLOOR))"

clean:
	rm -rf $(BUILD)
